// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model UserConfiguration {
  id                String   @id @default(cuid())
  shop              String
  googleTokens      String?  // JSON string of Google OAuth tokens
  microsoftTokens   String?  // JSON string of Microsoft OAuth tokens
  preferences       String?  // JSON string of user preferences
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([shop])
}

model SpreadsheetOperation {
  id                String   @id @default(cuid())
  shop              String
  sessionId         String
  operationType     String
  parameters        String   // JSON string of operation parameters
  code              String?  // Generated code for the operation
  status            String   @default("pending") // pending, executing, completed, failed
  result            String?  // JSON string of operation result
  error             String?  // Error message if failed
  createdAt         DateTime @default(now())
  completedAt       DateTime?
  
  @@index([shop, sessionId])
}